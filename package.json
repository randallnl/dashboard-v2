{
	"name": "dashboard-v2",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"db:migrate:local": "wrangler d1 migrations apply queerlective-dashboard --local",
		"db:migrate:remote": "wrangler d1 migrations apply queerlective-dashboard --remote",
		"db:migrations:list": "wrangler d1 migrations list queerlective-dashboard --remote",
		"deploy": "npm run deploy:app && npm run deploy:cron",
		"deploy:app": "npm run build && wrangler deploy",
		"deploy:cron": "wrangler deploy --config wrangler.cron.jsonc",
		"deploy:dry-run": "npm run build && wrangler deploy --dry-run",
		"deploy:cron:dry-run": "wrangler deploy --config wrangler.cron.jsonc --dry-run",
		"cf-types": "wrangler types --include-runtime false"
	},
	"devDependencies": {
		"@eslint/js": "latest",
		"@sveltejs/adapter-cloudflare": "latest",
		"@sveltejs/kit": "latest",
		"@sveltejs/vite-plugin-svelte": "latest",
		"@cloudflare/workers-types": "latest",
		"eslint": "latest",
		"eslint-plugin-svelte": "latest",
		"globals": "latest",
		"prettier": "latest",
		"prettier-plugin-svelte": "latest",
		"svelte": "latest",
		"svelte-check": "latest",
		"typescript-eslint": "latest",
		"typescript": "latest",
		"vite": "latest",
		"vitest": "latest",
		"wrangler": "latest"
	}
}
