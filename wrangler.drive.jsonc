{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "drive-dashboard-sync",
	"main": "src/drive-sync-worker.ts",
	"compatibility_date": "2026-11-03",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "queerlective-dashboard",
			"database_id": "fd34016a-db11-4ee7-8103-73f149118172"
		}
	],
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"vars": {
		"FINANCE_STATEMENTS_FOLDER_ID": "1msdCi_bCx9jPRjLxezB2rtbcQFCTfJ3g",
		"PROJECT_FILES_ROOT_FOLDER_ID": "1u2QhWgwADl3t0OM4oNRWSUoTRNZZMotw"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
