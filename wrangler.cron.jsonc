{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "monday-d1-sync",
	"main": "src/cron-worker.ts",
	"compatibility_date": "2026-07-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "queerlective-dashboard",
			"database_id": "fd34016a-db11-4ee7-8103-73f149118172"
		}
	],
	"secrets_store_secrets": [
		{
			"binding": "MONDAY_API_TOKEN",
			"store_id": "2b9ec8a0d6d742649ad4d3498815ca54",
			"secret_name": "Central_Monday_API_TOKEN"
		},
		{
			"binding": "DISCORD_VOTE_WEBHOOK_URL",
			"store_id": "2b9ec8a0d6d742649ad4d3498815ca54",
			"secret_name": "Discord_Vote_Webhook_URL"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["dashboard@nhciviccommons.com"]
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"DASHBOARD_URL": "https://dashboard-v2.randall-d53.workers.dev",
		"LOGIN_FROM_EMAIL": "dashboard@nhciviccommons.com",
		"LOGIN_FROM_NAME": "Queerlective CoLab"
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
